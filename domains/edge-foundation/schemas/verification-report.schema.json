{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-report.schema.json",
  "title": "Embedded Verification Report",
  "type": "object",
  "required": ["run_id", "verifier", "layers", "overall", "evidence_refs", "unverified_items"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string"},
    "verifier": {"type": "string"},
    "implementation_owner": {"type": ["string", "null"]},
    "independence_confirmed": {"type": "boolean"},
    "independence_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reviewed_subject": {
      "type": "object",
      "required": ["execution_source_set_ref", "result_identity_ref"],
      "properties": {
        "execution_source_set_ref": {"type": "string", "minLength": 1},
        "result_identity_ref": {"type": "string", "minLength": 1},
        "source_identity_ref": {"type": ["string", "null"]},
        "artifact_identity_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "decision_actor_identity_ref": {"type": "string", "minLength": 1},
    "input_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "report_sequence": {"type": "integer", "minimum": 1},
    "supersedes": {"type": ["string", "null"]},
    "layers": {
      "type": "object",
      "required": ["implemented", "host", "cross_build", "sil", "device", "hil", "release"],
      "properties": {
        "implemented": {"enum": ["not_run", "pass", "fail", "blocked", "not_applicable"]},
        "host": {"enum": ["not_run", "pass", "fail", "blocked", "not_applicable"]},
        "cross_build": {"enum": ["not_run", "pass", "fail", "blocked", "not_applicable"]},
        "sil": {"enum": ["not_run", "pass", "fail", "blocked", "not_applicable"]},
        "device": {"enum": ["not_run", "pass", "fail", "blocked", "not_applicable"]},
        "hil": {"enum": ["not_run", "pass", "fail", "blocked", "not_applicable"]},
        "release": {"enum": ["not_run", "pass", "fail", "blocked", "not_applicable"]}
      },
      "additionalProperties": false
    },
    "overall": {"enum": ["PASS", "PASS_WITH_RISK", "FAIL", "BLOCKED"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "unverified_items": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
