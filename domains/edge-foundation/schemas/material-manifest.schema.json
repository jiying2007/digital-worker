{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material-manifest.schema.json",
  "title": "Embedded Engineering Material Manifest",
  "type": "object",
  "required": ["run_id", "items", "readiness"],
  "properties": {
    "run_id": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "required", "status"],
        "properties": {
          "kind": {"enum": ["repo", "base_commit", "board_revision", "soc_mcu", "sdk", "kernel_rtos", "toolchain", "schematic", "datasheet_trm", "firmware", "log", "reproduction", "device_identity", "test_environment", "other"]},
          "required": {"type": "boolean"},
          "status": {"enum": ["available", "missing", "stale", "conflicting", "not_applicable"]},
          "source": {"type": ["string", "null"]},
          "version": {"type": ["string", "null"]},
          "evidence_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "readiness": {"enum": ["READY", "DEGRADED", "BLOCKED"]},
    "missing_critical": {"type": "array", "items": {"type": "string"}},
    "degradation_approved_by": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
