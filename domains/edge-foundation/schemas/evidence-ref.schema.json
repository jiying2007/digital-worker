{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-ref.schema.json",
  "title": "Embedded Evidence Reference",
  "type": "object",
  "required": ["evidence_id", "kind", "source", "collected_at", "integrity"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["source_code", "commit", "log", "core", "dump", "datasheet", "trm", "schematic", "waveform", "build", "ci", "binary", "device", "hil", "measurement", "test_report", "other"]},
    "source": {"type": "string", "minLength": 1},
    "version_or_revision": {"type": ["string", "null"]},
    "collected_at": {"type": "string", "format": "date-time"},
    "collector": {"type": ["string", "null"]},
    "integrity": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["verified", "partially_verified", "unverified"]},
        "sha256": {"type": ["string", "null"]},
        "commit_sha": {"type": ["string", "null"]},
        "device_identity": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "scope": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
