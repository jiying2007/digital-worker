{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/embedded/golden-case.schema.json",
  "title": "Embedded Golden Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "task_type", "workflow_mode", "expected_primary_experts", "required_evidence", "expected_gate_behavior", "forbidden_claims", "success_signals"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "workflow_mode": {"type": "string", "minLength": 1},
    "expected_primary_experts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "secondary_experts": {"type": "array", "items": {"type": "string"}},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_gate_behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "success_signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
