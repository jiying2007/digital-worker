{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deliverable-manifest.schema.json",
  "title": "Embedded Deliverable Manifest",
  "type": "object",
  "required": ["run_id", "task_type", "workflow_mode", "completed_gates", "artifacts", "gate_ledger_ref", "blockers", "open_risks", "unverified_items", "closure_status"],
  "properties": {
    "run_id": {"type": "string"},
    "task_type": {"type": "string"},
    "workflow_mode": {"type": "string"},
    "completed_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "gate_ledger_ref": {"type": "string"},
    "delivery_receipt_ref": {"type": ["string", "null"]},
    "verification_ref": {"type": ["string", "null"]},
    "review_ref": {"type": ["string", "null"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "open_risks": {"type": "array", "items": {"type": "string"}},
    "unverified_items": {"type": "array", "items": {"type": "string"}},
    "knowledge_candidates": {"type": "array", "items": {"type": "string"}},
    "closure_status": {"enum": ["COMPLETED", "COMPLETED_WITH_RISK", "BLOCKED"]}
  },
  "additionalProperties": false
}
