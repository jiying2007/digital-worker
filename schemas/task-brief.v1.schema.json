{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/task-brief.v1.schema.json",
  "title": "Task Brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item_id", "title", "type", "owner", "repo_roots", "goal", "non_goals", "acceptance_criteria", "required_verification", "allowed_actions", "forbidden_actions", "blocker_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["requirement", "defect", "investigation", "refactor", "review", "release"]},
    "priority": {"type": ["string", "null"]},
    "requester": {"type": ["string", "null"]},
    "owner": {"type": "string", "minLength": 1},
    "project_id": {"type": ["string", "null"]},
    "product_id": {"type": ["string", "null"]},
    "target_platform": {"type": ["string", "null"]},
    "target_board": {"type": ["string", "null"]},
    "target_os": {"type": ["string", "null"]},
    "repo_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "base_branch_or_commit": {"type": ["string", "null"]},
    "goal": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "current_behavior": {"type": ["string", "null"]},
    "expected_behavior": {"type": ["string", "null"]},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "interfaces": {"type": "array", "items": {"type": "string"}},
    "knowledge_refs": {"type": "array", "items": {"type": "string"}},
    "required_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "cross_build", "sil", "hil", "release"],
      "properties": {
        "host": {"enum": ["required", "optional", "not_applicable"]},
        "cross_build": {"enum": ["required", "optional", "not_applicable"]},
        "sil": {"enum": ["required", "optional", "not_applicable"]},
        "hil": {"enum": ["required", "optional", "not_applicable"]},
        "release": {"enum": ["required", "optional", "not_applicable"]}
      }
    },
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "approval_policy": {"type": ["string", "null"]},
    "blocker_policy": {"type": "string", "minLength": 1}
  }
}
