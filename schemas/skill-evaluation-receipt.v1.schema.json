{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/skill-evaluation-receipt.v1.schema.json",
  "title": "Skill Evaluation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluation_id", "case_id", "case_kind", "skill_id",
    "plan", "invocation_receipt", "contract_verdict", "semantic_evaluation",
    "case_evidence_eligible", "generated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_kind": {"enum": ["positive", "block"]},
    "skill_id": {"type": "string", "minLength": 1},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "domains/edge-foundation/evaluation/skill-evaluation-plan.yaml"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "invocation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "source_type", "runtime_provider", "runtime_id", "skill_contract_sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_type": {"enum": ["real", "synthetic"]},
        "runtime_provider": {"type": "string", "minLength": 1},
        "runtime_id": {"type": "string", "minLength": 1},
        "skill_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "contract_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expected_invocation_status", "observed_invocation_status", "checks"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "expected_invocation_status": {"enum": ["COMPLETED", "BLOCKED"]},
        "observed_invocation_status": {"enum": ["COMPLETED", "BLOCKED", "FAILED"]},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_valid", "skill_match", "status_match"],
          "properties": {
            "receipt_valid": {"type": "boolean"},
            "skill_match": {"type": "boolean"},
            "status_match": {"type": "boolean"}
          }
        }
      }
    },
    "semantic_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluator_kind", "evaluator_id", "evidence_ref", "notes"],
      "properties": {
        "status": {"enum": ["NOT_EVALUATED", "PASS", "FAIL"]},
        "evaluator_kind": {"enum": ["none", "human-review", "independent-evaluator"]},
        "evaluator_id": {"type": ["string", "null"]},
        "evidence_ref": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "case_evidence_eligible": {"type": "boolean"},
    "generated_at": {"type": "string", "minLength": 1}
  }
}
