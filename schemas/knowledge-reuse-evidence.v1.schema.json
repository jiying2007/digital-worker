{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/knowledge-reuse-evidence.v1.schema.json",
  "title": "Knowledge Reuse Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "run_id",
    "source_type",
    "evidence_origin",
    "observed_at",
    "knowledge_provider",
    "reuse_items",
    "knowledge_harvest_ref"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["real", "synthetic"]},
    "evidence_origin": {"enum": ["real-run", "controlled-fixture"]},
    "observed_at": {"type": "string", "minLength": 1},
    "knowledge_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "contract",
        "contract_version",
        "contract_canonical_sha256",
        "context_fingerprint"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contract": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1},
        "contract_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_fingerprint": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}
      }
    },
    "reuse_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "source_real",
          "authority_ref",
          "source_ref",
          "version_or_revision",
          "acl_state",
          "acl_evidence_refs",
          "freshness_state",
          "freshness_evidence_refs",
          "conflict_state",
          "provenance_ref",
          "actual_use_refs"
        ],
        "properties": {
          "knowledge_id": {"type": "string", "minLength": 1},
          "source_real": {"type": "boolean"},
          "authority_ref": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "version_or_revision": {"type": "string", "minLength": 1},
          "acl_state": {"enum": ["allowed", "denied", "unresolved"]},
          "acl_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "freshness_state": {"enum": ["fresh", "stale", "unresolved"]},
          "freshness_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "conflict_state": {"enum": ["none", "detected", "unresolved"]},
          "provenance_ref": {"type": "string", "minLength": 1},
          "actual_use_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "knowledge_harvest_ref": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
