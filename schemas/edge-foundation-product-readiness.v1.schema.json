{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/edge-foundation-product-readiness.v1.schema.json",
  "title": "Edge Foundation Product Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "operational_status", "blocking_scope",
    "development_blocking", "integration_blocking", "control_plane_blocking", "product_readiness_blocking",
    "eligible_for_product_review", "routing_authority", "canonical_routing",
    "promotion_gate_source", "required_tracks", "track_coverage", "receipts_scanned",
    "eligible_real_receipts", "evidence_run_ids", "blockers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["BLOCKED", "ELIGIBLE_FOR_PRODUCTIONIZATION_REVIEW"]},
    "operational_status": {"enum": ["product_readiness_in_progress", "eligible_for_productionization_review"]},
    "blocking_scope": {"enum": ["product-readiness-only", "none"]},
    "development_blocking": {"const": false},
    "integration_blocking": {"const": false},
    "control_plane_blocking": {"const": false},
    "product_readiness_blocking": {"type": "boolean"},
    "eligible_for_product_review": {"type": "boolean"},
    "routing_authority": {"const": "edge-foundation"},
    "canonical_routing": {"const": true},
    "promotion_gate_source": {"type": "string", "minLength": 1},
    "required_tracks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["debug", "feature", "review_release"]}},
    "track_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["debug", "feature", "review_release"],
      "properties": {
        "debug": {"$ref": "#/$defs/trackCoverage"},
        "feature": {"$ref": "#/$defs/trackCoverage"},
        "review_release": {"$ref": "#/$defs/trackCoverage"}
      }
    },
    "receipts_scanned": {"type": "integer", "minimum": 0},
    "eligible_real_receipts": {"type": "integer", "minimum": 0},
    "evidence_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}},
      "then": {
        "properties": {
          "operational_status": {"const": "product_readiness_in_progress"},
          "blocking_scope": {"const": "product-readiness-only"},
          "product_readiness_blocking": {"const": true},
          "eligible_for_product_review": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "ELIGIBLE_FOR_PRODUCTIONIZATION_REVIEW"}}},
      "then": {
        "properties": {
          "operational_status": {"const": "eligible_for_productionization_review"},
          "blocking_scope": {"const": "none"},
          "product_readiness_blocking": {"const": false},
          "eligible_for_product_review": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "trackCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_required", "eligible_count", "run_ids"],
      "properties": {
        "minimum_required": {"type": "integer", "minimum": 1},
        "eligible_count": {"type": "integer", "minimum": 0},
        "run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
