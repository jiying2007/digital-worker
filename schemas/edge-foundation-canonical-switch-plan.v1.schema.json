{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/edge-foundation-canonical-switch-plan.v1.schema.json",
  "title": "Edge Foundation Canonical Routing Switch Dry-Run Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "review_package_sha256",
    "review_package_status",
    "current_canonical_authority",
    "proposed_canonical_authority",
    "canonical_routing_switched",
    "apply_allowed",
    "allowed_change_classes",
    "forbidden_change_classes",
    "required_preserved_invariants",
    "required_followup_phases",
    "rollback_authority",
    "evidence_run_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "DRY_RUN_ONLY"},
    "review_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_package_status": {"const": "READY_FOR_INDEPENDENT_REVIEW"},
    "current_canonical_authority": {"const": "legacy-embedded-1plus7"},
    "proposed_canonical_authority": {"const": "edge-foundation"},
    "canonical_routing_switched": {"const": false},
    "apply_allowed": {"const": false},
    "allowed_change_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": [
        "canonical-routing-authority",
        "migration-phase-status",
        "routing-selector-entrypoint"
      ]}
    },
    "forbidden_change_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": [
        "legacy-identity-removal",
        "legacy-identity-deprecation",
        "skill-owner-rewrite",
        "pilot-threshold-change",
        "action-authority-expansion",
        "verification-independence-change",
        "review-independence-change",
        "provider-binding-change",
        "source-of-truth-authority-change",
        "production-ready-claim"
      ]}
    },
    "required_preserved_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_followup_phases": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["phase-4-deprecation", "phase-5-removal"]}
    },
    "rollback_authority": {"const": "legacy-embedded-1plus7"},
    "evidence_run_ids": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
