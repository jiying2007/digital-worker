{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/embedded-feasibility-review.v1.schema.json",
  "title": "Embedded Feasibility Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item_id", "reviewing_team", "overall_assessment", "architecture_impact", "platform_impact", "software_impact", "resource_budget", "dependencies", "risks", "verification_strategy", "open_questions", "evidence_refs", "confidence"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "reviewing_team": {"const": "embedded-system"},
    "overall_assessment": {"enum": ["FEASIBLE", "FEASIBLE_WITH_CONDITIONS", "NOT_FEASIBLE", "INSUFFICIENT_EVIDENCE"]},
    "architecture_impact": {"type": "array", "items": {"type": "string"}},
    "platform_impact": {"type": "array", "items": {"type": "string"}},
    "software_impact": {"type": "array", "items": {"type": "string"}},
    "resource_budget": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "verification_strategy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["C0", "C1", "C2", "C3", "C4", "C5", "C6"]}
  }
}
