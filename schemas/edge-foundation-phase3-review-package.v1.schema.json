{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/edge-foundation-phase3-review-package.v1.schema.json",
  "title": "Edge Foundation Phase-3 Canonical Routing Review Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "readiness_status",
    "readiness_sha256",
    "evidence_run_ids",
    "current_routing_authority",
    "proposed_routing_authority",
    "canonical_routing_currently_switched",
    "automatic_apply_allowed",
    "migration_invariants",
    "proposed_changes",
    "explicit_non_goals",
    "rollback_plan",
    "required_review_checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "READY_FOR_INDEPENDENT_REVIEW"},
    "readiness_status": {"const": "ELIGIBLE_FOR_REVIEW"},
    "readiness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_run_ids": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "current_routing_authority": {"const": "legacy-embedded-1plus7"},
    "proposed_routing_authority": {"const": "edge-foundation"},
    "canonical_routing_currently_switched": {"const": false},
    "automatic_apply_allowed": {"const": false},
    "migration_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "proposed_changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "explicit_non_goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_review_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
