{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/skill-semantic-evidence.v1.schema.json",
  "title": "Independent Skill Semantic Evaluation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "skill_id", "evaluation_plan_sha256", "invocation_receipt_sha256", "evaluator_kind", "evaluator_id", "independence_confirmed", "status", "summary", "evidence_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "\\S"},
    "skill_id": {"type": "string", "pattern": "\\S"},
    "evaluation_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "invocation_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_kind": {"enum": ["human-review", "independent-evaluator"]},
    "evaluator_id": {"type": "string", "pattern": "\\S"},
    "independence_confirmed": {"const": true},
    "status": {"enum": ["PASS", "FAIL"]},
    "summary": {"type": "string", "pattern": "\\S"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}}
  }
}
