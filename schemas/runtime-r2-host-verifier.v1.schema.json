{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/runtime-r2-host-verifier.v1.schema.json",
  "title": "Runtime R2 Host Verifier Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "replay_self_contained",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "digital-worker-runtime-r2-host-verifier/v1"
    },
    "replay_self_contained": {
      "const": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "entrypoint",
          "args"
        ],
        "properties": {
          "kind": {
            "enum": [
              "python",
              "shell",
              "unittest"
            ]
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          }
        }
      }
    }
  }
}
