{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/hil-evidence.v1.schema.json",
  "title": "HIL Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item_id", "device_id", "board_revision", "firmware_identity", "test_case", "result", "artifact_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "board_revision": {"type": "string", "minLength": 1},
    "firmware_identity": {"type": "string", "minLength": 1},
    "environment_identity": {"type": ["string", "null"]},
    "test_case": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "blocked"]},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "artifact_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
