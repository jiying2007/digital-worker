{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/edge-foundation-canonical-switch-change-manifest.v1.schema.json",
  "title": "Edge Foundation Canonical Switch Change Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "switch_plan_sha256",
    "candidate_base_sha",
    "candidate_head_sha",
    "canonical_routing_target",
    "legacy_compatibility_preserved",
    "phase4_deprecation_included",
    "phase5_removal_included",
    "action_authority_changed",
    "verification_independence_changed",
    "review_independence_changed",
    "provider_binding_changed",
    "changes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "CANDIDATE_ONLY"},
    "switch_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "canonical_routing_target": {"const": "edge-foundation"},
    "legacy_compatibility_preserved": {"const": true},
    "phase4_deprecation_included": {"const": false},
    "phase5_removal_included": {"const": false},
    "action_authority_changed": {"const": false},
    "verification_independence_changed": {"const": false},
    "review_independence_changed": {"const": false},
    "provider_binding_changed": {"const": false},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change_class"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "change_class": {"enum": [
            "canonical-routing-authority",
            "migration-phase-status",
            "routing-selector-entrypoint"
          ]}
        }
      }
    }
  }
}
