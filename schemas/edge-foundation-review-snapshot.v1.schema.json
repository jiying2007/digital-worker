{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/edge-foundation-review-snapshot.v1.schema.json",
  "title": "Edge Foundation Review Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "derived_view", "authority", "sources",
    "architecture", "skills", "retained_evidence", "runtime_replaceability",
    "review_material", "external_decision_status", "remaining_evidence_gates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "edge-foundation-review-snapshot"},
    "derived_view": {"const": true},
    "authority": {"const": "none-derived-from-canonical-assets"},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_status", "domain_experts", "embedded_capabilities", "task_types", "gates"],
      "properties": {
        "domain_status": {"type": "string"},
        "domain_experts": {"type": "integer", "minimum": 0},
        "embedded_capabilities": {"type": "integer", "minimum": 0},
        "task_types": {"type": "integer", "minimum": 0},
        "gates": {"type": "integer", "minimum": 0}
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered", "review_grade_contracts", "evaluation_plan_skills",
        "positive_cases", "block_cases", "total_evaluation_cases",
        "retained_evaluated_summaries", "evaluated_skill_ids",
        "retained_real_invocation_receipts", "real_attributed_skill_ids",
        "current_claimable_floor", "skill_portability_proven"
      ],
      "properties": {
        "registered": {"type": "integer", "minimum": 0},
        "review_grade_contracts": {"type": "integer", "minimum": 0},
        "evaluation_plan_skills": {"type": "integer", "minimum": 0},
        "positive_cases": {"type": "integer", "minimum": 0},
        "block_cases": {"type": "integer", "minimum": 0},
        "total_evaluation_cases": {"type": "integer", "minimum": 0},
        "retained_evaluated_summaries": {"type": "integer", "minimum": 0},
        "evaluated_skill_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "retained_real_invocation_receipts": {"type": "integer", "minimum": 0},
        "real_attributed_skill_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "current_claimable_floor": {"enum": ["DEFINED", "EVALUATED", "PILOTED", "REPEATABLE", "GOVERNED", "CANONICAL-STABLE"]},
        "skill_portability_proven": {"type": "boolean"}
      }
    },
    "retained_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real_pilot_results", "real_pilot_pass_results", "real_pilot_pass_by_track"],
      "properties": {
        "real_pilot_results": {"type": "integer", "minimum": 0},
        "real_pilot_pass_results": {"type": "integer", "minimum": 0},
        "real_pilot_pass_by_track": {
          "type": "object",
          "additionalProperties": false,
          "required": ["debug", "feature", "review_release"],
          "properties": {
            "debug": {"type": "integer", "minimum": 0},
            "feature": {"type": "integer", "minimum": 0},
            "review_release": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "runtime_replaceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r2_freeze_receipts", "r2_qualified_receipts", "status", "skill_portability_inherited"],
      "properties": {
        "r2_freeze_receipts": {"type": "integer", "minimum": 0},
        "r2_qualified_receipts": {"type": "integer", "minimum": 0},
        "status": {"enum": ["NO_RETAINED_EVIDENCE", "FROZEN_PENDING_QUALIFICATION", "QUALIFIED_EVIDENCE_PRESENT"]},
        "skill_portability_inherited": {"const": false}
      }
    },
    "review_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "root_skills_index", "review_guide", "maturity_ledger", "evaluation_guide", "end_to_end_checklist"],
      "properties": {
        "status": {"enum": ["READY", "INCOMPLETE"]},
        "root_skills_index": {"type": "boolean"},
        "review_guide": {"type": "boolean"},
        "maturity_ledger": {"type": "boolean"},
        "evaluation_guide": {"type": "boolean"},
        "end_to_end_checklist": {"type": "boolean"}
      }
    },
    "external_decision_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_readiness", "productionization", "note"],
      "properties": {
        "product_readiness": {"const": "use-dedicated-product-readiness-evaluator"},
        "productionization": {"const": "use-human-governance-review"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "remaining_evidence_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
