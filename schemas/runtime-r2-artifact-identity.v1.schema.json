{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/runtime-r2-artifact-identity.v1.schema.json",
  "title": "Runtime R2 Artifact Identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "work_item_id",
    "repository",
    "source_commit",
    "source_blob_sha",
    "path",
    "size_bytes",
    "sha256"
  ],
  "properties": {
    "schema": {
      "const": "digital-worker-runtime-r2-artifact-identity/v1"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
