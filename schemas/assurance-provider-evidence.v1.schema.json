{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-worker.local/schemas/assurance-provider-evidence.v1.schema.json",
  "title": "Assurance Provider Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "work_item_id", "run_id", "source_type", "evidence_origin", "assurance_role", "provider_binding_ref", "provider_receipt", "provider_subject", "reviewed_subject", "subject_mapping_evidence_refs", "integrity_status", "collected_at"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["real", "synthetic"]},
    "evidence_origin": {"enum": ["real-run", "controlled-fixture"]},
    "assurance_role": {"enum": ["independent-review-evidence", "verification-evidence"]},
    "provider_binding_ref": {"type": "string", "pattern": "^config/integrations/cross-repo-lock\\.json#/assurance_bindings/[A-Za-z0-9_-]+$"},
    "provider_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256", "kind", "schema_version"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kind": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "provider_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "fingerprint"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "reviewed_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_source_set_ref", "result_identity_ref"],
      "properties": {
        "execution_source_set_ref": {"type": "string", "minLength": 1},
        "result_identity_ref": {"type": "string", "minLength": 1},
        "source_identity_ref": {"type": ["string", "null"]}
      }
    },
    "subject_mapping_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "integrity_status": {"enum": ["verified", "unverified"]},
    "collected_at": {"type": "string", "minLength": 1}
  }
}
