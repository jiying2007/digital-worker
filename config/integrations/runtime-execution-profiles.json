{
  "schema_version": 1,
  "status": "active",
  "default_development_profile": "codex-cli-native",
  "profiles": {
    "codex-cli-native": {
      "runtime": "codex",
      "runtime_target": "codex-cli",
      "executor": "native-cli",
      "executable": "codex",
      "credential_mode": "runtime-managed-session",
      "endpoint_mode": "runtime-managed",
      "intended_scope": [
        "development",
        "operator-run",
        "controlled-r2"
      ],
      "source_set_binding": "required",
      "execution_receipt": "real-execution-facts-only",
      "verification_authority": false
    },
    "claude-cli-native": {
      "runtime": "claude-code",
      "runtime_target": "claude-code",
      "executor": "native-cli",
      "executable": "claude",
      "credential_mode": "runtime-managed-session",
      "endpoint_mode": "runtime-managed",
      "intended_scope": [
        "operator-run",
        "controlled-r2"
      ],
      "source_set_binding": "required",
      "execution_receipt": "real-execution-facts-only",
      "verification_authority": false
    }
  },
  "rules": {
    "runtime_identity_is_independent_from_transport": true,
    "credential_material_must_not_enter_source_control": true,
    "credential_material_must_not_enter_execution_receipts": true,
    "endpoint_or_gateway_must_be_recorded_as_non_secret_execution_metadata_when_material": true,
    "native_cli_may_reuse_existing_authenticated_runtime_session": true,
    "relay_or_gateway_must_not_change_declared_runtime_identity": true,
    "execution_output_is_not_verification_pass": true,
    "provider_or_gateway_receipt_is_not_domain_decision_authority": true,
    "r2_requires_same_frozen_task_and_independent_runtime_execution": true,
    "r2_provider_execution_must_use_runtime_owned_local_terminal": true
  }
}
