  "contract_text": "{\n  \"schema_version\": 2,\n  \"contract_version\": \"1.2\",\n  \"status\": \"qualified-provider-adoption-candidate\",\n  \"implementation_status\": \"qualified\",\n  \"adoption_status\": \"candidate\",\n  \"consumer\": \"digital-worker\",\n  \"provider\": \"knowledge-hub\",\n  \"role\": \"knowledge-control-plane\",\n  \"ssot\": {\n    \"digital_worker\": [\n      \"work_item\",\n      \"expert_routing\",\n      \"gate\",\n      \"technical_decision\",\n      \"engineering_handoff\",\n      \"verification\",\n      \"review\"\n    ],\n    \"knowledge_hub\": [\n      \"knowledge_registry\",\n      \"knowledge_lifecycle\",\n      \"knowledge_context\",\n      \"knowledge_proposal_review\"\n    ],\n    \"source_systems\": [\n      \"source_code\",\n      \"build_artifact\",\n      \"device\",\n      \"ci_hil_evidence\"\n    ]\n  },\n  \"read_surfaces\": {\n    \"context\": \"tools/knowledge-context.sh\",\n    \"evidence_pack\": \"tools/knowledge-evidence-pack.sh\",\n    \"action_check\": \"tools/knowledge-action-check.sh\"\n  },\n  \"write_surfaces\": {\n    \"proposal_route\": \"tools/knowledge-proposal-route.sh\"\n  },\n  \"identity\": {\n    \"required_inputs\": [\n      \"work_item_id\",\n      \"run_id\",\n      \"scope_ref\"\n    ],\n    \"optional_context\": [\n      \"principal_id\",\n      \"organization_id\",\n      \"groups\",\n      \"delegated_by\",\n      \"purpose\",\n      \"traceparent\"\n    ],\n    \"returned_fields\": [\n      \"source_fingerprint\",\n      \"knowledge_ids\",\n      \"status\",\n      \"provenance\",\n      \"acl_state\"\n    ]\n  },\n  \"failure_semantics\": {\n    \"missing_required_source\": \"BLOCKED\",\n    \"conflicting_authority\": \"NEEDS_REVIEW\",\n    \"provisional_only\": \"NEEDS_REVIEW\",\n    \"provider_unavailable\": \"BLOCKED\",\n    \"principal_acl_denied\": \"BLOCKED\",\n    \"untrusted_instruction\": \"DATA_ONLY\"\n  },\n  \"write_policy\": {\n    \"direct_active_mutation\": false,\n    \"knowledge_harvest_must_route_as_proposal\": true,\n    \"owner_promotion_required\": true\n  },\n  \"runtime_contract\": {\n    \"phase\": \"P4-P9\",\n    \"provider_entrypoint\": \"tools/runtime/knowledge-digital-worker-interop.sh\",\n    \"platform_entrypoint\": \"tools/runtime/knowledge-platform-v5.sh\",\n    \"operations\": [\n      \"readiness\",\n      \"handshake\",\n      \"handoff\"\n    ],\n    \"required_provider_capabilities\": [\n      \"knowledge.search\",\n      \"knowledge.context\",\n      \"knowledge.evidence-pack\",\n      \"knowledge.action-check\",\n      \"a2a.preflight\",\n      \"execution.receipt.write\"\n    ],\n    \"protocols\": {\n      \"mcp\": \"2026-07-28\",\n      \"a2a\": \"1.0.0\"\n    },\n    \"mcp_native_profile\": \"stateless-2026-07-28\",\n    \"a2a_role\": \"provider-card-and-preflight-only\",\n    \"network_required\": false,\n    \"task_execution\": false\n  },\n  \"handoff_contract\": {\n    \"schema_version\": \"knowledge-hub.agent-handoff.v1\",\n    \"required_identity\": [\n      \"work_item_id\",\n      \"run_id\",\n      \"scope_ref\"\n    ],\n    \"task_binding\": \"sha256-only\",\n    \"task_echoed\": false,\n    \"execution_receipt_correlation\": \"optional-but-verified-if-present\",\n    \"execution_receipt_agent_binding\": \"must-match-from-agent-if-present\",\n    \"scope_enforcement\": \"from-and-target-agent-knowledge-scopes\",\n    \"principal_acl_enforcement\": \"p6-pre-ranking\",\n    \"trace_propagation\": \"w3c-traceparent-optional\",\n    \"consumer_work_item_ssot\": true,\n    \"canonical_write_permitted\": false,\n    \"handoff_executes_task\": false\n  },\n  \"compatibility_intelligence\": {\n    \"owner\": \"knowledge-hub\",\n    \"registry\": \"registry/compatibility-embedded-v0.json\",\n    \"digital_worker_access\": \"reference-only\"\n  },\n  \"provider_lock_policy\": \"integration may be selected without freezing the architecture provider choice\",\n  \"source_of_truth_policy\": \"stays-at-source\"\n}\n",
